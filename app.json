{
  "expo": {
    "name": "TrouveDocDue",
    "slug": "trouve-doc-due",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "trouvedocdue",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nltsravi.trouvedocdue",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "TrouveDocDue scans accessible photos on-device to discover personal documents and dates such as passport or insurance expiry. Processing stays completely local."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#071B3A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.nltsravi.trouvedocdue",
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#071B3A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 80
        }
      ],
      "expo-sqlite",
      [
        "expo-media-library",
        {
          "photosPermission": "TrouveDocDue scans accessible photos on your device to find personal documents and dates. Processing stays completely on your device.",
          "savePhotosPermission": false,
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Select photos from your gallery for document discovery.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#2563EB"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true,
            "useLegacyPackaging": true
          },
          "ios": {
            "usePrecompiledModules": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "382751f3-b857-4da6-99a4-00cdc210dde7"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/382751f3-b857-4da6-99a4-00cdc210dde7"
    }
  }
}